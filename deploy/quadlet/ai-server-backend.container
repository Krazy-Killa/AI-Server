[Unit]
Description=AI Server backend (rootless Podman)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Container]
Image=localhost/ai-server:lab
ContainerName=ai-server-backend
Exec=python -m uvicorn main:app --host 0.0.0.0 --port 8000
WorkingDir=/opt/ai-server/ai-backend
UserNS=keep-id
User=999:990
PublishPort=127.0.0.1:8000:8000
AddHost=pve.mshome.net:host-gateway
Volume=/var/lib/ai-server:/var/lib/ai-server:rw
Volume=/opt/ai-server/.env:/opt/ai-server/.env:ro
Volume=/etc/ai-server/proxmox-root-ca.pem:/etc/ai-server/proxmox-root-ca.pem:ro
Environment=HOME=/var/lib/ai-server
Environment=AI_SERVER_HEALTH_URL=http://127.0.0.1:8000/openapi.json
HealthCmd=python /opt/ai-server/ai-backend/container_healthcheck.py
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
ReadOnly=true
ReadOnlyTmpfs=true
NoNewPrivileges=true
DropCapability=all

[Service]
Restart=on-failure
RestartSec=5s
