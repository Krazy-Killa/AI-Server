# Copy this file to .env and adjust values for this machine.
# Blank path values use the application's platform-specific defaults.
# Keep .env private; never put credentials in this template.

# Local model storage and llama.cpp server
# Set an absolute path when the defaults do not match this machine.
AI_SERVER_MODEL_DIR=
LLAMA_SERVER_EXECUTABLE=
LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# Change to the device name reported by the local llama.cpp build if needed.
LLAMA_CPP_DEVICE=
LLAMA_CPP_GPU_LAYERS=99
LLAMA_CPP_CTX_SIZE=4096
LLAMA_CPP_TIMEOUT_SECONDS=120

# Chat limits
AI_SERVER_MAX_TOKENS=256
AI_SERVER_MAX_CHAT_CHARS=4000

# Browser origins allowed to call the API and open the chat WebSocket.
# Comma-separated; blank uses the local dashboard (http://127.0.0.1:8001).
AI_SERVER_CORS_ORIGINS=

# Backend logging. Blank log directory uses the platform default.
AI_SERVER_LOG_LEVEL=INFO
AI_SERVER_LOG_DIR=

# Optional web research; run scripts/searxng/install-searxng.sh in WSL, then run-searxng.bat.
SEARXNG_BASE_URL=http://127.0.0.1:8888

# Optional Discord bot. Leave empty until a token is configured.
DISCORD_TOKEN=
AI_SERVER_API_BASE=http://127.0.0.1:8000
